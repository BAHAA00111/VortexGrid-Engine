{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "GPU Utilization & Memory Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Percentage (%)",
            "axisPlacement": "auto",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 2 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "DCGM_FI_DEV_GPU_UTIL{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} - GPU {{gpu}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GPU Compute Utilization (%)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Memory (Bytes)",
            "axisPlacement": "auto",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 2 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "DCGM_FI_DEV_FB_USED{hostname=~\"$hostname\"} * 1024 * 1024",
          "legendFormat": "Used VRAM: {{hostname}} GPU {{gpu}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "DCGM_FI_DEV_FB_FREE{hostname=~\"$hostname\"} * 1024 * 1024",
          "legendFormat": "Free VRAM: {{hostname}} GPU {{gpu}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "GPU Frame Buffer Memory (VRAM Usage)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 10 },
      "id": 4,
      "title": "Hardware Health, Power & Thermal Telemetry",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "axisLabel": "Power (Watts)",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 350 },
              { "color": "red", "value": 650 }
            ]
          },
          "unit": "watt"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "DCGM_FI_DEV_POWER_USAGE{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} GPU {{gpu}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GPU Power Draw (Watts)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "axisLabel": "Temperature (°C)",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "celsius"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "DCGM_FI_DEV_GPU_TEMP{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} GPU {{gpu}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GPU Core Temperature (°C)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Clock Speed (MHz)",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "hertz"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "DCGM_FI_DEV_SM_CLOCK{hostname=~\"$hostname\"} * 1000000",
          "legendFormat": "{{hostname}} GPU {{gpu}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "SM Clock Frequencies (MHz)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["gpu", "telemetry", "dcgm", "vortexgrid", "pytorch"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "label": "Data Source",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(DCGM_FI_DEV_GPU_UTIL, hostname)",
        "hide": 0,
        "includeAll": true,
        "label": "Hostname / Node",
        "multi": true,
        "name": "hostname",
        "options": [],
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL, hostname)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "title": "VortexGrid :: GPU Telemetry & Health Dashboard",
  "uid": "vortexgrid-gpu-telemetry",
  "version": 1
}